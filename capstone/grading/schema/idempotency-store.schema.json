{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/mleitass/eai-2026/capstone/grading/schema/idempotency-store.schema.json",
  "title": "Intake idempotency store",
  "description": "/data/idempotency-store.json on intake (README §3.5): the client's Idempotency-Key → its record (R-4.1.11–18). `response` is what the key replays; it is required once the state is `done`. A key the request did not keep (a 400, a 503) is not in the store.",
  "type": "object",
  "propertyNames": { "pattern": "^[A-Za-z0-9._:-]{1,128}$" },
  "additionalProperties": {
    "type": "object",
    "required": ["bodySha256", "state", "createdAt"],
    "properties": {
      "bodySha256": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$",
        "description": "SHA-256 of the raw request body, lower-case hex (R-4.1.13)."
      },
      "state": { "type": "string", "enum": ["in_flight", "done"] },
      "response": {
        "type": "object",
        "required": ["status", "body"],
        "properties": {
          "status": { "type": "integer", "minimum": 200, "maximum": 599 },
          "body": {}
        },
        "additionalProperties": true
      },
      "correlationId": { "type": "string", "minLength": 1 },
      "createdAt": { "type": "string", "format": "date-time" }
    },
    "if": { "properties": { "state": { "const": "done" } } },
    "then": { "required": ["response"] },
    "additionalProperties": true
  }
}
