{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/mleitass/eai-2026/capstone/grading/schema/order-status.schema.json",
  "title": "Order status",
  "description": "GET /orders/:correlationId on intake (README §4.4, R-4.4.1), and each value of /data/orders.json (§3.5). businessKey is `${source}:${orderId}` (R-3.3.4). `code` is present for failed, compensated and compensation_failed; `duplicateOf` for duplicate (R-4.4.3). Extra fields are allowed.",
  "type": "object",
  "required": ["correlationId", "businessKey", "orderId", "source", "orderType", "state", "updatedAt"],
  "properties": {
    "correlationId": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$",
      "description": "A UUID v4, generated by intake (R-3.3.1)."
    },
    "businessKey": { "type": "string", "pattern": "^(web|mobile|b2b):.+$" },
    "orderId": { "type": "string", "minLength": 1 },
    "source": { "type": "string", "enum": ["web", "mobile", "b2b"] },
    "orderType": { "type": "string", "enum": ["standard", "express", "b2b"] },
    "state": {
      "type": "string",
      "enum": [
        "accepted",
        "processing",
        "parked",
        "completed",
        "failed",
        "compensated",
        "compensation_failed",
        "needs_attention",
        "duplicate"
      ]
    },
    "code": { "type": "string", "minLength": 1 },
    "duplicateOf": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$",
      "description": "The correlationId of the first order with this businessKey (R-4.2.3)."
    },
    "updatedAt": { "type": "string", "format": "date-time" }
  },
  "allOf": [
    {
      "if": { "properties": { "state": { "enum": ["failed", "compensated", "compensation_failed"] } } },
      "then": { "required": ["code"] }
    },
    {
      "if": { "properties": { "state": { "const": "duplicate" } } },
      "then": { "required": ["duplicateOf"] }
    }
  ],
  "additionalProperties": true
}
